# ============================================================
# VK Auto Publisher — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real credentials.

# --- VK API ---
VK_ACCESS_TOKEN=your_vk_standalone_or_group_token_here
VK_GROUP_ID=123456789
VK_API_VERSION=5.199

# --- LLM API (OpenAI-compatible / Gemini / DeepSeek) ---
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Image Generation API ---
IMAGE_API_KEY=your_image_api_key_here
IMAGE_API_URL=https://api.fal.ai/v1
IMAGE_MODEL=fal-ai/flux/schnell

# --- Scheduler ---
POST_INTERVAL_HOURS=3

# --- Rendering ---
CARD_WIDTH=1080
CARD_HEIGHT=1350

# --- Logging ---
LOG_LEVEL=INFO
