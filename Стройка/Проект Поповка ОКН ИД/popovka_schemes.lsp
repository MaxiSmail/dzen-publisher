  (defun _l (p1 p2 lay)
    (entmake (list '(0 . "LINE") (cons 8 lay) (cons 10 p1) (cons 11 p2)))
  )
  (defun _r (p1 p2 lay)
    (let ((x1 (car p1)) (y1 (cadr p1))
          (x2 (car p2)) (y2 (cadr p2)))
      (entmake (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay)
                     '(100 . "AcDbPolyline") '(90 . 4) '(70 . 1)
                     (cons 10 (list x1 y1))
                     (cons 10 (list x2 y1))
                     (cons 10 (list x2 y2))
                     (cons 10 (list x1 y2))
               ))
    )
  )
  (defun _c (cen rad lay)
    (entmake (list '(0 . "CIRCLE") (cons 8 lay) (cons 10 cen) (cons 40 rad)))
  )
  (defun _t (str pt h lay align)
    (let ((flag (cond ((= align "C") 1) ((= align "R") 2) (t 0))))
      (if (= flag 0)
        (entmake (list '(0 . "TEXT") (cons 8 lay) (cons 7 "ISOCPEUR") (cons 10 pt) (cons 40 h) (cons 1 str)))
        (entmake (list '(0 . "TEXT") (cons 8 lay) (cons 7 "ISOCPEUR") (cons 10 pt) (cons 11 pt) (cons 40 h)
                       (cons 1 str) (cons 72 flag) (cons 73 0)))
      )
    )
  )
