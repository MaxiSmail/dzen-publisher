  (defun _draw_demo_pillar (px pw)
    (_r (list px fnd_y 0.0) (list (+ px pw) gnd_y 0.0) "ИС_Демонтаж_Кладка")
    (_r (list px gnd_y 0.0) (list (+ px pw) top_y 0.0) "ИС_Демонтаж_Кладка")
    (_r (list (- (+ px (/ pw 2.0)) 25.0) gnd_y 0.0) (list (+ (+ px (/ pw 2.0)) 25.0) top_y 0.0) "ИС_Демонтаж_Металл")
    (setq pk_x (+ px (/ pw 2.0)) pk_y (+ top_y 550.0))
    (_l (list (- px 80.0) top_y 0.0) (list pk_x pk_y 0.0) "ИС_Демонтаж_Кладка")
    (_l (list (+ px pw 80.0) top_y 0.0) (list pk_x pk_y 0.0) "ИС_Демонтаж_Кладка")
    (_l (list (- px 80.0) top_y 0.0) (list (+ px pw 80.0) top_y 0.0) "ИС_Демонтаж_Кладка")
    (_l (list pk_x pk_y 0.0) (list pk_x top_y 0.0) "ИС_Тонкая")
  )

